# OpenSEO Configuration
DATAFORSEO_API_KEY=your_dataforseo_api_key_here

# Google Search Console Configuration
GSC_OAUTH_CLIENT_SECRETS_FILE=C:/absolute/path/to/client_secrets.json
GSC_CREDENTIALS_PATH=C:/absolute/path/to/service_account.json
GSC_SKIP_OAUTH=false
GSC_DATA_STATE=all
GSC_ALLOW_DESTRUCTIVE=false

# GEO Optimizer Configuration (for citation checks)
PERPLEXITY_API_KEY=your_perplexity_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Claude SEO Configuration (optional enrichment tiers)
# Tier 0: No keys required
# Tier 1: PageSpeed Insights + CrUX
PAGESPEED_API_KEY=your_pagespeed_api_key
# Tier 2: Google Search Console
# Tier 3: Google Analytics 4
GA4_MEASUREMENT_ID=your_ga4_measurement_id
GA4_CREDENTIALS_PATH=C:/absolute/path/to/ga4_credentials.json
# Tier 4: Google Ads
ADS_API_KEY=your_ads_api_key